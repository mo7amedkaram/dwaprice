# Copy to .env.local (git-ignored). Server-side only: never prefix with NEXT_PUBLIC_.

# Read-only role from part 1 (web_reader), through the Supavisor pooler.
# Create/rotate with: node db/checks/set_web_reader_password.mjs .env.local
WEB_DATABASE_URL=postgresql://web_reader.rksvuvxheduesqibykra:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional: PEM of the Supabase root CA to verify the pooler's TLS certificate.
# Without it the connection is encrypted but the certificate is not verified.
WEB_DATABASE_CA=

# Canonical origin used for canonical URLs, sitemaps, Open Graph and JSON-LD.
SITE_URL=https://dwaprice.com

# Shared secret for POST /api/revalidate (tag-based ISR revalidation).
REVALIDATE_SECRET=

# Public contact address shown on /contact and /about (default info@dwaprice.com).
CONTACT_EMAIL=

# Optional: connections per server process (default 3, max 15; the role allows 20 in total).
WEB_DB_POOL_MAX=

# ---------------------------------------------------------------- Drug Prices API (docs/API_SPEC.md)
# Role api_app (web views + schema api). Create/rotate with: node db/checks/set_role_password.mjs api_app <file>
API_DATABASE_URL=postgresql://api_app.rksvuvxheduesqibykra:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Signs cursors and export links; protects the internal jobs endpoint (>= 32 random characters).
API_SECRET=
# Canonical public base URL of the API (used in Location headers and export links).
API_BASE_URL=https://api.dwaprice.com/v1
# Optional: connections per server process (default 5, max 15; api_app allows 20).
API_DB_POOL_MAX=
# Optional: Upstash Redis for rate limiting (Postgres api.rate_buckets is used when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: admin alerts (abuse detection, paused webhooks) by email through Resend.
RESEND_API_KEY=
ADMIN_EMAIL=
ALERT_FROM_EMAIL=alerts@dwaprice.com
# Optional: Vercel Cron calls GET /api/v1/internal/jobs with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Local tests only: lets webhooks target localhost/private addresses (never set in production).
API_ALLOW_PRIVATE_WEBHOOKS=
# Admin page (/admin/api): accounts live in api.admin_users (e-mail + password); create one with
#   node scripts/api-admin.mjs admin:create --email you@example.com --name "Name"   (password prompted or --password)
# Local only: show magic-link URLs on the login page instead of sending e-mail (never in production).
API_DEV_LOGIN_LINKS=
# Optional: WhatsApp number (international format, digits only) offered as a secondary contact on /api/request-access.
WHATSAPP_NUMBER=
