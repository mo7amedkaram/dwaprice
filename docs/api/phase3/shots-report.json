  "flow": [
    {
      "step": "docs ar → English switch",
      "path": "/api/en/docs",
      "h1": "Dwaprice Drug Prices API v1.0.0"
    },
    {
      "step": "English docs → Try the sample",
      "path": "/api/en/sample",
      "h1": "Try the API on a real sample",
      "chrome": "en"
    },
    {
      "step": "English explorer: q=augmentn",
      "ok": true
    },
    {
      "step": "English → Developer dashboard (login)",
      "path": "/developer/login",
      "h1": "Developer dashboard",
      "chrome": "en"
    },
    {
      "step": "English overview → request access → terms",
      "path": "/api/en/terms",
      "h1": "API license terms"
    },
    {
      "step": "back to Arabic → dashboard login in Arabic",
      "path": "/developer/login",
      "h1": "لوحة المطورين",
      "chrome": "ar"
    },
    {
      "step": "sample explorer: q=اوجمنتن",
      "ids": [
        "augmentin-1-2g-vial-for-i-v-inj-inf",
        "amoxicillin",
        "clavulanic-acid",
        "glaxosmithkline-manufactured-by-medical-union-pharmaceuticals-mup-egypt",
        "antibacterial"
      ]
    },
    {
      "step": "request access submitted",
      "url": "http://localhost:3100/api/request-access?sent=1"
    },
    {
      "step": "admin login with a wrong password",
      "alert": "البريد الإلكتروني أو كلمة المرور غير صحيحة.",
      "emailKept": "showcase-admin@example.com"
    },
    {
      "step": "admin login with e-mail + password",
      "path": "/admin/api"
    },
    {
      "step": "approved → client page → key issued once",
      "clientUrl": "http://localhost:3100/admin/api/clients/bd78dafd-bcf3-4bd7-9432-3591cc84a15b",
      "keyPrefix": "dp_live_qpf6ukel…"
    },
    {
      "step": "issued key works against /v1/meta",
      "dataset_version": "2026-10-21.1"
    },
    {
      "step": "admin pages without a session",
      "path": "/admin/api/login"
    },
    {
      "step": "developer: create → rotate → revoke",
      "keys": [
        "POS backenddp_live_ctfrizt4…drugs:read, changes:readملغى—",
